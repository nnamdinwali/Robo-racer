<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout: WebView takes all available space above the banner.
  BannerAdView sits at the bottom, visibility=gone by default.
  The game JS calls AndroidBridge.showBanner()/hideBanner() to toggle it.
  This ensures the banner never overlaps game UI (Huawei AppGallery compliant).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.yandex.mobile.ads.banner.BannerAdView
        android:id="@+id/bannerAdView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>